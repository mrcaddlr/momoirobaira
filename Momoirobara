#!/bin/bash
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
URL="file://$DIR/index.html"

if flatpak info com.google.Chrome >/dev/null 2>&1; then
  exec flatpak run --filesystem=home com.google.Chrome --app="$URL"
fi
if command -v google-chrome-stable >/dev/null 2>&1; then
  exec google-chrome-stable --app="$URL"
fi
if command -v google-chrome >/dev/null 2>&1; then
  exec google-chrome --app="$URL"
fi
if command -v chromium >/dev/null 2>&1; then
  exec chromium --app="$URL"
fi
if command -v chromium-browser >/dev/null 2>&1; then
  exec chromium-browser --app="$URL"
fi
>&2 echo "Google Chrome/Chromium was not found."
exit 1

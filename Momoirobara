#!/usr/bin/env python3
import os, sys, time, json, socket, subprocess, urllib.request, urllib.error
from pathlib import Path

ROOT = Path(__file__).resolve().parent
BASE_PORT = 8787
SERVER = ROOT / 'momoirobara_server.py'
INDEX = ROOT / 'index.html'
STATE = ROOT / 'momoirobara-data.json'


def die(msg, code=1):
    print(f'\n[Momoirobara ERROR] {msg}', file=sys.stderr)
    print(f'[Momoirobara] folder: {ROOT}', file=sys.stderr)
    raise SystemExit(code)

def which(name):
    for p in os.environ.get('PATH','').split(os.pathsep):
        c = Path(p) / name
        if c.is_file() and os.access(c, os.X_OK): return str(c)
    return None

def health(port):
    try:
        with urllib.request.urlopen(f'http://127.0.0.1:{port}/api/health', timeout=.45) as r:
            if r.status != 200: return None
            d=json.loads(r.read().decode())
            return d if d.get('service') == 'momoirobara' and d.get('ok') else None
    except Exception:
        return None

def port_open(port):
    with socket.socket() as s:
        s.settimeout(.2)
        try:
            s.connect(('127.0.0.1', port)); return True
        except OSError:
            return False

def choose_port():
    for port in range(BASE_PORT, BASE_PORT + 50):
        h=health(port)
        if h:
            return port, h, False
        if not port_open(port):
            return port, None, True
    die('Could not find a free local port in 8787-8826.')

def main():
    print(f'[Momoirobara] folder: {ROOT}')
    if not INDEX.is_file(): die('index.html is missing.')
    if not SERVER.is_file(): die('momoirobara_server.py is missing.')
    if not which('python3'): die('python3 was not found on PATH.')
    if not which('flatpak'): die('flatpak was not found on PATH.')
    if subprocess.run(['flatpak','info','com.google.Chrome'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
        die('Flatpak Google Chrome (com.google.Chrome) is not installed.')

    port, existing, should_start = choose_port()
    server=None
    owns_server=False
    if existing:
        existing_root=Path(existing.get('root','')).resolve() if existing.get('root') else None
        if existing_root == ROOT.resolve():
            print(f'[Momoirobara] existing Momoirobara server found on {port}; reusing it.')
        else:
            # A different Momoirobara folder owns the port. Find a new one rather than writing to its state file.
            for candidate in range(port+1, BASE_PORT+50):
                if health(candidate):
                    h=health(candidate)
                    if h and Path(h.get('root','')).resolve() == ROOT.resolve():
                        port=candidate; existing=h; break
                if not port_open(candidate):
                    port=candidate; existing=None; should_start=True; break
            if existing:
                print(f'[Momoirobara] another instance owns {BASE_PORT}; using its matching server on {port}.')
            else:
                print(f'[Momoirobara] port {BASE_PORT} is occupied by another instance; using free port {port}.')

    if should_start:
        print(f'[Momoirobara] starting local server on {port}...')
        server=subprocess.Popen([sys.executable,str(SERVER),str(port)],cwd=str(ROOT),stdin=subprocess.DEVNULL)
        owns_server=True
        ready=False
        for _ in range(60):
            if server.poll() is not None:
                die(f'Local server exited during startup with code {server.returncode}.')
            h=health(port)
            if h:
                ready=True; break
            time.sleep(.1)
        if not ready:
            die(f'Local server did not become ready on port {port}.')
    else:
        if not existing:
            die('Could not determine the running Momoirobara server.')

    url=f'http://127.0.0.1:{port}/index.html'
    print(f'[Momoirobara] server OK: {url}')
    print('[Momoirobara] opening Flatpak Google Chrome...')
    try:
        chrome=subprocess.Popen(['flatpak','run','com.google.Chrome',f'--app={url}'],cwd=str(ROOT))
    except Exception as e:
        if owns_server and server and server.poll() is None: server.terminate()
        die(f'Could not launch Flatpak Google Chrome: {e}')

    try:
        while True:
            if owns_server and server.poll() is not None:
                die(f'Local server stopped unexpectedly with code {server.returncode}.')
            # If the launcher started Chrome, stopping it should stop our server too.
            if chrome.poll() is not None:
                break
            time.sleep(.5)
    except KeyboardInterrupt:
        print('\n[Momoirobara] stopping...')
    finally:
        if owns_server and server and server.poll() is None:
            server.terminate()
            try: server.wait(timeout=2)
            except subprocess.TimeoutExpired: server.kill()

if __name__ == '__main__': main()

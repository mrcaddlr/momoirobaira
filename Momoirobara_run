#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PORT="8787"
cd "$DIR"
if command -v python3 >/dev/null 2>&1; then
  python3 -m http.server "$PORT" --bind 127.0.0.1 >/tmp/momoirobara-http.log 2>&1 &
  SERVER_PID=$!
else
  echo "Momoirobara needs python3 for the local launcher." >&2
  exit 1
fi
cleanup(){ kill "$SERVER_PID" 2>/dev/null || true; }
trap cleanup EXIT INT TERM
sleep 0.5
URL="http://127.0.0.1:${PORT}/index.html"
if command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$URL" >/dev/null 2>&1 || true
elif command -v kde-open6 >/dev/null 2>&1; then
  kde-open6 "$URL" >/dev/null 2>&1 || true
elif command -v google-chrome >/dev/null 2>&1; then
  google-chrome "$URL" >/dev/null 2>&1 || true
elif command -v chromium >/dev/null 2>&1; then
  chromium "$URL" >/dev/null 2>&1 || true
else
  echo "Open $URL in your browser."
fi
wait "$SERVER_PID"
